{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "allow-connection-current",
    "allow-connection-connect",
    "allow-device-info",
    "allow-device-power",
    "allow-device-reboot",
    "allow-device-play-alert",
    "allow-storage-info",
    "allow-app-icon-set",
    "allow-screen-start",
    "allow-screen-stop",
    "allow-input-send",
    "allow-file-save",
    "allow-storage-list",
    "allow-storage-stat",
    "allow-storage-read",
    "allow-storage-write",
    "allow-storage-mkdir",
    "allow-storage-rename",
    "allow-storage-remove",
    "allow-storage-md5",
    "allow-transfer-upload",
    "allow-transfer-download",
    "allow-transfer-cancel",
    "allow-upload-pick",
    "allow-dropped-items",
    "allow-download-folder-pick",
    "allow-upload-folder-pick",
    "allow-library-scan",
    "allow-app-start",
    "allow-firmware-latest",
    "allow-firmware-fork-latest",
    "allow-firmware-pick",
    "allow-firmware-install",
    "allow-backup-list",
    "allow-backup-create",
    "allow-backup-restore",
    "allow-cli-attach",
    "allow-cli-write",
    "allow-cli-detach",
    "allow-diagnostics",
    "allow-device-clock-get",
    "allow-device-clock-set",
    "allow-connection-switch",
    "allow-sync-links",
    "allow-sync-link-add",
    "allow-sync-link-remove",
    "allow-sync-preview",
    "allow-sync-apply",
    "allow-bluetooth-enable"
