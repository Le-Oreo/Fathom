{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FATHOM",
  "version": "0.1.0",
  "identifier": "com.antma.fathom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FATHOM",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FATHOM",
    "shortDescription": "Desktop companion for the Flipper Zero",
    "category": "Utility",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/41-fathom-flipper.rules": "udev/41-fathom-flipper.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/41-fathom-flipper.rules": "udev/41-fathom-flipper.rules"
        }
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}
